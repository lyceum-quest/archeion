# sent_id = urn:cts:greekLit:tlg0012.tlg001.perseus-grc2:1.1.8
# text = ἔνθʼ ἄλλοι μὲν πάντες ἐπευφήμησαν Ἀχαιοὶ αἰδεῖσθαί θʼ ἱερῆα καὶ ἀγλαὰ δέχθαι ἄποινα·
# sentence_id = 8
