# sent_id = urn:cts:greekLit:tlg0012.tlg001.perseus-grc2:1.33.18
# text = ἀλλʼ ἄγε δή τινα μάντιν ἐρείομεν ἢ ἱερῆα ἢ καὶ ὀνειροπόλον, καὶ γάρ τʼ ὄναρ ἐκ Διός ἐστιν, ὅς κʼ εἴποι ὅ τι τόσσον ἐχώσατο Φοῖβος Ἀπόλλων, εἴτʼ ἄρʼ ὅ γʼ εὐχωλῆς ἐπιμέμφεται ἠδʼ ἑκατόμβης, αἴ κέν πως ἀρνῶν κνίσης αἰγῶν τε τελείων βούλεται ἀντιάσας ἡμῖν ἀπὸ λοιγὸν ἀμῦναι.
# sentence_id = 31
# translation_lang = en
# prose_translation = "But come, let us ask some seer or priest, or even an interpreter of dreams—for a dream too comes from Zeus—who might tell us why Phoebus Apollo is so greatly angered, whether he blames us for a vow or a hecatomb left unpaid, and whether, if he somehow accepts the savor of lambs and unblemished goats, he may be willing to ward off this plague from us."
# literal_translation = "But come now, let us ask some seer or priest or even a dream-interpreter—for a dream too is from Zeus—who might say why so greatly Phoebus Apollo has grown angry, whether, then, he blames [us] for a vow and a hecatomb, if somehow, having met with the savor of lambs and unblemished goats, he wishes to ward off ruin from us."
