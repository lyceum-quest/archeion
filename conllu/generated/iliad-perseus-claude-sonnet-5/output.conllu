# sent_id = urn:cts:greekLit:tlg0012.tlg001.perseus-grc2:1.130.7
# text = ἀλλʼ ἤτοι μὲν ταῦτα μεταφρασόμεσθα καὶ αὖτις, νῦν δʼ ἄγε νῆα μέλαιναν ἐρύσσομεν εἰς ἅλα δῖαν, ἐν δʼ ἐρέτας ἐπιτηδὲς ἀγείρομεν, ἐς δʼ ἑκατόμβην θείομεν, ἂν δʼ αὐτὴν Χρυσηΐδα καλλιπάρῃον βήσομεν·
# sentence_id = 73
# translation_lang = en
# prose_translation = Well, we will discuss these matters again later; but now come, let us drag the black ship down into the sacred sea, gather rowers for it on purpose, put aboard a hecatomb, and bring fair-cheeked Chryseis herself aboard.
# literal_translation = But indeed these things we will discuss again again; but now come, the black ship let us drag into the sacred sea, and in it let us gather rowers for the purpose, and into it let us place a hecatomb, and up into it let us bring fair-cheeked Chryseis herself.
