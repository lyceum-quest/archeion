# sent_id = urn:cts:greekLit:tlg0012.tlg001.perseus-grc2:1.130.10
# text = ὤ μοι ἀναιδείην ἐπιειμένε κερδαλεόφρον πῶς τίς τοι πρόφρων ἔπεσιν πείθηται Ἀχαιῶν ἢ ὁδὸν ἐλθέμεναι ἢ ἀνδράσιν ἶφι μάχεσθαι;
# sentence_id = 76
# translation_lang = en
# prose_translation = Shame on you, clothed in shamelessness, you schemer—how can any of the Achaeans willingly obey your words, whether to go on a journey or to fight men with strength?
# literal_translation = Woe to me, [you who are] clad in shamelessness, scheming-minded one, how might any of the Achaeans, willing, obey [you] with [your] words, either to go on a journey or to fight men by might?
