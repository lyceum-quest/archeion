# sent_id = urn:cts:greekLit:tlg0012.tlg001.perseus-grc2:1.1.13
# text = ἀλλʼ ἴθι μή μʼ ἐρέθιζε σαώτερος ὥς κε νέηαι.
# sentence_id = 13
# translation_lang = en
